{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work unit links",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "emojis", "goal", "description", "dod", "references", "participants", "asana", "implementations"],
  "properties": {
    "schema_version": {"const": 4},
    "id": {"type": "string", "format": "uuid", "pattern": "^[0-9a-f-]{36}$"},
    "name": {"type": "string", "minLength": 1},
    "emojis": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "minLength": 1}},
    "goal": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "dod": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "references": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["label", "target"],
        "properties": {
          "label": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1}
        }
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["tool", "kind", "id", "last_seen_at"],
        "properties": {
          "tool": {"type": "string", "minLength": 1},
          "kind": {"enum": ["agent", "session"]},
          "id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "last_seen_at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "asana": {
      "type": "array",
      "uniqueItems": true,
      "items": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_gid", "url", "verified_at"],
      "properties": {
        "task_gid": {"type": "string", "pattern": "^[0-9]+$"},
        "url": {"type": "string", "pattern": "^https://app\\.asana\\.com/"},
        "key": {"type": "string", "minLength": 1},
        "verified_at": {"type": "string", "format": "date-time"}
      }
      }
    },
    "implementations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["repository_url", "branch", "worktree_paths", "merge_request_urls", "verified_at"],
        "properties": {
          "repository_url": {"type": "string", "minLength": 1},
          "branch": {"type": "string", "minLength": 1},
          "worktree_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
          "merge_request_urls": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^https://[^/]+/.+/-/merge_requests/[0-9]+$"}},
          "verified_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
